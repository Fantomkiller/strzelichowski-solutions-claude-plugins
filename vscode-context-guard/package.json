{
  "name": "context-guard-status",
  "displayName": "Context Guard status",
  "description": "Shows Claude Code context fill and usage limits (5-hour, weekly) on the VS Code status bar and reminds you to hand off. Reads what the context-guard Claude Code plugin writes.",
  "version": "0.4.0",
  "publisher": "strzelichowski-solutions",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextGuard.showDetails",
        "title": "Context Guard: Usage details"
      },
      {
        "command": "contextGuard.copyHandoff",
        "title": "Context Guard: Copy handoff command"
      },
      {
        "command": "contextGuard.refresh",
        "title": "Context Guard: Refresh"
      }
    ]
  }
}
